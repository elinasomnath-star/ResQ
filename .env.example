# ResQ Demo Authentication Configuration
# Copy this file to .env and adjust values for your environment.
# Never commit .env with real credentials.

# Seed account passwords (demo only)
RESQ_VIEWER_PASSWORD=your_viewer_password_here
RESQ_OPERATOR_PASSWORD=your_operator_password_here

# JWT Secret and Expiration (minutes)
RESQ_JWT_SECRET=generate_a_random_32_character_hex_secret_here
RESQ_JWT_EXPIRY_MINUTES=60

# Frontend origin for CORS
RESQ_FRONTEND_ORIGIN=http://localhost:5173
